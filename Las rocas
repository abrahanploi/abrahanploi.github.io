  const dishes = [
    {id:1,name:"Carnes y parrilladas al carbón",desc:"Cortes seleccionados, jugosos y asados a la perfección. Acompañados de papa, yuca o bollito y suero costeño de la casa.",price:0,image:"https://images.unsplash.com/photo-1544025162-d76694265947?auto=format&fit=crop&w=900&q=85",alt:"Parrillada de carnes"},
