  const cart = {};
  const money = n => new Intl.NumberFormat("es-CO",{style:"currency",currency:"COP",maximumFractionDigits:0}).format(n);
  function renderMenu(){
    document.getElementById("menuGrid").innerHTML = dishes.map(d=>`
      <article class="dish">
        <img src="${d.image}" alt="${d.alt}" loading="lazy">
        <div class="dish-body"><h3>${d.name}</h3><p>${d.desc}</p>
          <div class="dish-foot"><span class="price">${d.price>0?money(d.price):"Precio por confirmar"}</span>
          <button class="btn" onclick="addToCart(${d.id})">Agregar +</button></div>
        </div>
      </article>`).join("");
  }
  function addToCart(id){cart[id]=(cart[id]||0)+1;renderCart();openCart()}
  function changeQty(id,delta){cart[id]=(cart[id]||0)+delta;if(cart[id]<=0)delete cart[id];renderCart()}
  function renderCart(){
    const entries=Object.entries(cart);const count=entries.reduce((s,[,q])=>s+q,0);
    document.getElementById("cartCount").textContent=count;
    const items=document.getElementById("cartItems");
    if(!entries.length){items.innerHTML='<div class="empty">Todavía no has agregado platos.<br>¡Elige algo delicioso del menú!</div>'}
    else{items.innerHTML=entries.map(([id,q])=>{const d=dishes.find(x=>x.id===Number(id));return `<div class="cart-row"><div><b>${d.name}</b><small>${d.price>0?money(d.price)+" c/u":"Precio por confirmar"}</small></div><div class="qty"><button onclick="changeQty(${d.id},-1)" aria-label="Quitar uno">−</button><b>${q}</b><button onclick="changeQty(${d.id},1)" aria-label="Agregar uno">+</button></div></div>`}).join("")}
    const allPriced=entries.length>0&&entries.every(([id])=>dishes.find(d=>d.id===Number(id)).price>0);
    const total=entries.reduce((s,[id,q])=>s+dishes.find(d=>d.id===Number(id)).price*q,0);
    document.getElementById("cartTotal").textContent=allPriced?money(total):"Por confirmar";
  }
  function openCart(){document.getElementById("cart").classList.add("open");document.getElementById("overlay").classList.add("open")}
  function closeCart(){document.getElementById("cart").classList.remove("open");document.getElementById("overlay").classList.remove("open")}
  function sendOrder(){
    const entries=Object.entries(cart);if(!entries.length){alert("Agrega al menos un plato a tu pedido.");return}
    const lines=entries.map(([id,q])=>{const d=dishes.find(x=>x.id===Number(id));return `• ${d.name} x${q}${d.price>0?" — "+money(d.price*q):""}`});
    const total=entries.every(([id])=>dishes.find(d=>d.id===Number(id)).price>0)?`\nTotal estimado: ${money(entries.reduce((s,[id,q])=>s+dishes.find(d=>d.id===Number(id)).price*q,0))}`:"\nPor favor, confirmen precios y disponibilidad.";
    const msg=`Hola THE CHAYAN'S, quiero realizar este pedido:\n\n${lines.join("\n")}${total}\n\n¿Me confirman disponibilidad, costo del domicilio y tiempo de entrega?`;
    window.open("https://wa.me/573015631308?text="+encodeURIComponent(msg),"_blank","noopener");
  }
  document.getElementById("year").textContent=new Date().getFullYear();
  renderMenu();renderCart();
</script>
